{
	"name": "better-youtube",
	"version": "1.0.0",
	"description": "YouTube caption refinement and AI-powered summarization",
	"packageManager": "pnpm@10.28.1",
	"type": "module",
	"scripts": {
		"dev": "vite",
		"build": "pnpm run generate:provider-logos && pnpm exec tsc && vite build && vite build --config vite.content.config.ts",
		"build:demo": "pnpm run generate:provider-logos && pnpm exec tsc && VITE_DEMO_MODE=true VITE_ROUTER_MODE=hash vite build",
		"generate:provider-logos": "node --experimental-strip-types src/generate-provider-logos.ts",
		"preview": "vite preview",
		"lint": "biome lint .",
		"test:chrome-tab": "node --experimental-strip-types --test tests/chromeTabTranscript.test.ts"
	},
	"dependencies": {
		"@google/genai": "^1.38.0",
		"@langchain/core": "^1.1.39",
		"@langchain/google-genai": "^2.1.26",
		"@langchain/langgraph": "^1.2.8",
		"@langchain/openai": "^1.4.4",
		"@radix-ui/react-collapsible": "^1.1.11",
		"@radix-ui/react-label": "^2.1.7",
		"@radix-ui/react-popover": "^1.1.14",
		"@radix-ui/react-select": "^2.2.5",
		"@radix-ui/react-slot": "^1.2.3",
		"@radix-ui/react-switch": "^1.2.5",
		"@radix-ui/react-toast": "^1.2.14",
		"@radix-ui/react-tooltip": "^1.2.7",
		"class-variance-authority": "^0.7.1",
		"clsx": "^2.1.1",
		"langchain": "^1.3.2",
		"lucide-react": "^0.462.0",
		"opencc-js": "^1.0.5",
		"react": "^18.3.1",
		"react-dom": "^18.3.1",
		"react-markdown": "^10.1.0",
		"react-router-dom": "^6.30.1",
		"remark-gfm": "^4.0.1",
		"sonner": "^1.7.4",
		"tailwind-merge": "^3.3.1",
		"tailwindcss-animate": "^1.0.7",
		"zod": "^3.25.76",
		"zod-to-json-schema": "^3.25.1"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.11",
		"@tailwindcss/typography": "^0.5.16",
		"@types/chrome": "^0.0.260",
		"@types/node": "^22.16.5",
		"@types/react": "^18.3.23",
		"@types/react-dom": "^18.3.7",
		"@vitejs/plugin-react-swc": "^3.11.0",
		"autoprefixer": "^10.4.21",
		"postcss": "^8.5.6",
		"sharp": "^0.34.5",
		"tailwindcss": "^3.4.17",
		"typescript": "^5.8.3",
		"vite": "^7.3.0",
		"vite-plugin-node-polyfills": "^0.24.0"
	}
}
